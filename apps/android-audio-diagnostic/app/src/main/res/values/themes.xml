<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activity window theme. Compose draws the screens: light scheme for ordinary screens, dark for splash/live call. -->
    <style name="Theme.SellAgent" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_content_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorPrimary">@color/brand_gold</item>
        <item name="android:colorAccent">@color/brand_gold</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
