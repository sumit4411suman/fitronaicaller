<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only brand theme for the Activity window (Compose draws everything else). -->
    <style name="Theme.SellAgent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:colorPrimary">@color/brand_gold</item>
        <item name="android:colorAccent">@color/brand_gold</item>
        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
