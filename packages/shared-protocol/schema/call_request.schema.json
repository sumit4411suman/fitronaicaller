{
  "$defs": {
    "AudioRoute": {
      "enum": [
        "earpiece",
        "speaker",
        "bluetooth",
        "wired_headset",
        "unknown"
      ],
      "title": "AudioRoute",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Backend -> device: place a call. The device must verify ``authorization_token``\nmatches the current session and refuse when emergency stop is active.",
  "properties": {
    "authorization_token": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Authorization Token",
      "type": "string"
    },
    "call_job_id": {
      "title": "Call Job Id",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "e164_number": {
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "title": "E164 Number",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "language": {
      "default": "auto",
      "enum": [
        "hi",
        "en",
        "auto"
      ],
      "title": "Language",
      "type": "string"
    },
    "mode": {
      "default": "human_assisted",
      "enum": [
        "human_assisted",
        "autonomous"
      ],
      "title": "Mode",
      "type": "string"
    },
    "requested_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioRoute"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "call_job_id",
    "e164_number",
    "authorization_token",
    "expires_at"
  ],
  "title": "CallRequest",
  "type": "object",
  "x-protocol-version": "1.0"
}
