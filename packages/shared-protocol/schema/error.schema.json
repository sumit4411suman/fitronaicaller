{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 64,
      "title": "Code",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "message": {
      "maxLength": 1000,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorEvent",
  "type": "object",
  "x-protocol-version": "1.0"
}
