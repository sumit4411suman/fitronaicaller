{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generic desktop notification, e.g. queue.ready, followup.due, report.ready, worker.error.",
  "properties": {
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_.]+$",
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "Event",
  "type": "object",
  "x-protocol-version": "1.0"
}
