    <string name="help_title">Help &amp; Support</string>
    <string name="help_subtitle">From docs/ANDROID_APPS.md</string>
    <string name="help_pairing_title">Pairing</string>
    <string name="help_pairing_text">Phone and PC must be on the same Wi-Fi. On Windows open Devices › Pair; enter IP, port 8766, the code and the SHA-256 fingerprint exactly as shown; approve on the PC. If the PC regenerates its certificate, pair again.</string>
    <string name="help_calls_title">Calls</string>
    <string name="help_calls_text">Call requests from the PC appear in Calls › Queue. The phone never dials by itself: tap Dial. Autonomous requests are refused in this release. Emergency Stop blocks dialing until the PC clears it.</string>
    <string name="help_dialer_title">Why the default phone app role?</string>
    <string name="help_docs_title">Full documentation</string>
    <string name="help_docs_text">See docs/ANDROID_APPS.md in the SELL AGENT repository for build, install, permissions, test steps and known limitations.</string>
    <string name="about_no_account">Local app: no account, no login, no cloud. Data stays between this phone and your PC.</string>

